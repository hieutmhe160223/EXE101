APIFY_ACTOR_TAOBAO_DETAIL=zen-studio~taobao-detail-scraper
RAPIDAPI_KEY=
VIETQR_BANK_CODE=
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
