# Enable only after linking the receiving bank to SePay and installing the webhook.
WALLET_TOPUP_ENABLED=false
WALLET_TOPUP_MIN_AMOUNT=10000
WALLET_TOPUP_MAX_AMOUNT=50000000
WALLET_TOPUP_EXPIRY_MINUTES=10
SEPAY_WEBHOOK_API_KEY=
# Exact gateway name sent by SePay, e.g. Vietcombank. VietQR uses its bank code/BIN separately.
SEPAY_GATEWAY=
